        client.assert(response.body.content.every(user => user.password === undefined), "в ответе есть пароли");
    });
%}

### Пользователи недоступны USER - 403
GET {{gateway}}/api/bookings/user
Authorization: Bearer {{userToken}}

> {%
    client.test("403", () => {
        client.assert(response.status === 403, "статус " + response.status);
    });
%}
